# Quix SDK token — find this in Quix Portal → Settings → Tokens (SDK Tokens section)
Quix__Sdk__Token=

# Kafka broker address injected by the Quix platform (e.g. host:9093)
Quix__Broker__Address=

# Workspace ID — used to prefix topic names (e.g. quixdev-sinkeventtrigger-feature)
Quix__Workspace__Id=

# Output topic name (Quix platform injects this automatically in Cloud)
output=timeouted-data

# Test scenario to run (1-5)
SCENARIO=3

# Local override for non-Quix Kafka brokers
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Optional tuning (defaults match the sink deployment in quix.yaml)
# COMMIT_INTERVAL_MS=2000
# STREAM_TIMEOUT_SECONDS=6
# BURST_SIZE=10
# BURST_INTERVAL_MS=100
# LOGLEVEL=INFO
